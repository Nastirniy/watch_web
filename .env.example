# Production environment variables for Radio Monitoring System
# Copy to .env and fill in real values. Never commit .env to version control.
# All variables override the corresponding config.toml values at startup.
# Pattern: MYSETTINGS_<SECTION>__<FIELD>

# ------------------------------------------------------------------ app
MYSETTINGS_APP__ENVIRONMENT=production
MYSETTINGS_APP__DEBUG=false

# ------------------------------------------------------------------ database
# MySQL runs on the host; containers reach it on 127.0.0.1 (host network)
MYSETTINGS_DATABASE__HOST=127.0.0.1
MYSETTINGS_DATABASE__PORT=3306
MYSETTINGS_DATABASE__NAME=radio_monitoring
MYSETTINGS_DATABASE__USER=radio_user
MYSETTINGS_DATABASE__PASSWORD=CHANGE_ME

# ------------------------------------------------------------------ security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MYSETTINGS_SECURITY__SECRET_KEY=CHANGE_ME
# Access token lifetime; the client refreshes it with POST /api/v1/auth/refresh
MYSETTINGS_SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30
# A session ends after this long without a request; every request and refresh moves the end
MYSETTINGS_SECURITY__SESSION_IDLE_TIMEOUT_MINUTES=30
# Optional hard limit since the login, whatever the activity; 0: an active session never ends by itself
MYSETTINGS_SECURITY__SESSION_MAX_HOURS=0

# ------------------------------------------------------------------ server
MYSETTINGS_SERVER__HOST=127.0.0.1
MYSETTINGS_SERVER__PORT=60800
MYSETTINGS_SERVER__WORKERS=4
# Uncomment if terminating TLS in uvicorn (not behind nginx/proxy):
# MYSETTINGS_SERVER__SSL_KEYFILE=/etc/ssl/private/server.key
# MYSETTINGS_SERVER__SSL_CERTFILE=/etc/ssl/certs/server.crt

# ------------------------------------------------------------------ admin PKI
# Serves only the development seed (the admin user of a fresh development database). In production the first
# administrator gets a certificate from `python -m app.backend.cli.pki issue` (PKI.md).
# Certificate data for the admin user created on first startup, in the form nginx reports it:
# serial in hex, fingerprint SHA-1 ($ssl_client_serial, $ssl_client_fingerprint; colons are ignored)
# Get values from: openssl x509 -in admin.crt -noout -subject -serial -fingerprint -sha1
MYSETTINGS_ADMIN__PKI_CERTIFICATE_CN=admin@yourdomain.com
MYSETTINGS_ADMIN__PKI_CERTIFICATE_SERIAL=CHANGE_ME
MYSETTINGS_ADMIN__PKI_CERTIFICATE_FINGERPRINT=CHANGE_ME

# ------------------------------------------------------------------ storage
# Bare-metal (venv) runs read these; docker-compose.yml overrides them from MEDIA_ROOT / NGINX_UPLOAD_TEMP below
MYSETTINGS_STORAGE__UPLOAD_PATH=/var/www/radio_monitoring/uploads
MYSETTINGS_STORAGE__ENABLE_NGINX=true
# MYSETTINGS_STORAGE__NGINX_UPLOAD_TEMP_PATH=/var/www/nginx_uploads
# MYSETTINGS_STORAGE__NGINX_INTERNAL_UPLOADS_PREFIX=/protected_uploads
# MYSETTINGS_STORAGE__FFMPEG_PATH=ffmpeg

# ------------------------------------------------------------------ imgproxy (thumbnails)
# Generate both with: python3 -c "import secrets; print(secrets.token_hex(32))"
# IMGPROXY_KEY / IMGPROXY_SALT configure the imgproxy container; the MYSETTINGS_ pair must hold the same values.
IMGPROXY_KEY=CHANGE_ME
IMGPROXY_SALT=CHANGE_ME
MYSETTINGS_STORAGE__IMGPROXY__KEY=${IMGPROXY_KEY}
MYSETTINGS_STORAGE__IMGPROXY__SALT=${IMGPROXY_SALT}
# Public origin for signed thumbnail URLs handed to browsers
MYSETTINGS_STORAGE__IMGPROXY__PUBLIC_BASE_URL=https://yourdomain.com
# MYSETTINGS_STORAGE__IMGPROXY__URL=http://127.0.0.1:8080

# ------------------------------------------------------------------ release (RELEASE.md)
# The release every watch-web service runs (api, media-worker, pki-signer, db-backup, migrate): an image
# watch-web:<YYYY.MM.DD>-<sha7> made by deploy/release.sh build. deploy/release.sh deploy and rollback change this line
# (the previous file is kept as .env.bak); docker compose stops with a message while it is missing.
WATCH_WEB_TAG=CHANGE_ME
# imgproxy, pinned: the exact version tag, plus @sha256:<digest> where the image store resolves it after docker load
# (RELEASE.md, "Pin imgproxy"). Read the id on the server, never guess it:
#   docker image inspect --format '{{.Id}}' ghcr.io/imgproxy/imgproxy:v3.31.4
# IMGPROXY_IMAGE_ID is that image id (content digest); release.sh compares it before every deploy.
IMGPROXY_IMAGE=ghcr.io/imgproxy/imgproxy:v3.31.4
IMGPROXY_IMAGE_ID=sha256:CHANGE_ME

# ------------------------------------------------------------------ docker compose (application services only)
# Media directory on the host: local disk or a mounted NFS/SMB share. Bind-mounted at the same path into
# the api, media-worker and imgproxy containers. host nginx serves it with `alias`.
MEDIA_ROOT=/var/www/radio_monitoring/uploads
# Directory host nginx writes offloaded uploads to (client_body_temp_path); mounted into the api container
NGINX_UPLOAD_TEMP=/var/www/nginx_uploads
# uid/gid that own MEDIA_ROOT; the containers run as this user (`id -u www-data` for example)
MEDIA_UID=33
MEDIA_GID=33
# Ports on 127.0.0.1 the host nginx proxies to (containers use the host network)
API_PORT=8000
IMGPROXY_PORT=8080
IMGPROXY_METRICS_PORT=8081
# WORKER_MEMORY_LIMIT=1g
# IMGPROXY_MEMORY_LIMIT=1g
# Largest image imgproxy renders, in megapixels; the api container reads the same value and marks larger images
# unsupported (their thumbnails could never render). It guards against small files holding gigapixels (CPU time per
# render), not against memory: 250 covers 200 MP phone cameras (DEPLOYMENT.md, "Thumbnails").
# IMGPROXY_MAX_SRC_RESOLUTION=250

# ------------------------------------------------------------------ database backups
# Backups of the database by the db-backup tool service and a systemd timer (BACKUPS.md). Optional.
# Enable the override (add :docker-compose.backup-copy.yml for an off-host copy, :docker-compose.pki.yml with PKI):
# COMPOSE_FILE=docker-compose.yml:docker-compose.backup.yml
# Host directory for the backups (0750, BACKUP_UID:BACKUP_GID; bind-mounted at the same path)
# BACKUP_DIR=/srv/watch_web/backups
# A user and group of their own for the backups (`id -u watch-web-backup`, `getent group watch-web-backup`): the
# tool runs as them, the api joins the group; never MEDIA_UID / MEDIA_GID (often the nginx user)
# BACKUP_UID=
# BACKUP_GID=
# MariaDB's data directory (SELECT @@datadir), mounted read-only for the free-space check before a restore
# DB_DATADIR=/var/lib/mysql
# A mounted network share for the off-host copy (needs docker-compose.backup-copy.yml)
# BACKUP_COPY_DIR=/mnt/backup-share/watch_web
# Compose sets MYSETTINGS_BACKUP__DIR and COPY_DIR from these. The rest is optional (defaults shown, ENV.md):
# MYSETTINGS_BACKUP__STALE_AFTER_HOURS=26
# MYSETTINGS_BACKUP__KEEP_DAILY=7

# ------------------------------------------------------------------ PKI
# Client certificates issued by the application (PKI.md). Optional: without it docker-compose.yml runs as it is.
# Enable the override file with the signer container and the API mounts:
# COMPOSE_FILE=docker-compose.yml:docker-compose.pki.yml
# Host directory with ca/, private/, crl/, issued/, run/ (bind-mounted at the same path)
# PKI_DIR=/srv/watch_web/pki
# uid that owns PKI_DIR/private and runs the signer (`id -u watch-web-signer`)
# PKI_SIGNER_UID=
# gid of a group of its own for the signer socket, with no host account in it (`getent group watch-web-pki`):
# the signer runs with it, the api joins it; never MEDIA_GID (host accounts such as the nginx user share that one)
# PKI_SOCKET_GID=
# Compose sets MYSETTINGS_PKI__CA_CERT_PATH, SIGNER_SOCKET, STORE_DIR and CRL_PATH from PKI_DIR: do not set them
# here. The rest is optional (defaults shown). The signer has its own limits (signer.env): keep MAX_VALIDITY_DAYS
# at most SIGNER_MAX_VALIDITY_DAYS and CRL_DAYS at most SIGNER_MAX_CRL_DAYS, or it refuses (500 on issue, no CRL).
# CRL files appended to the published one, a JSON list (the CRL of the existing root while its certificates live)
# MYSETTINGS_PKI__EXTRA_CRL_PATHS=["/srv/watch_web/pki/crl/legacy-root.crl"]
# 1 to MAX_VALIDITY_DAYS
# MYSETTINGS_PKI__VALIDITY_DAYS=365
# MYSETTINGS_PKI__MAX_VALIDITY_DAYS=730
# 2048 to 4096
# MYSETTINGS_PKI__KEY_SIZE=2048
# aes256, or legacy (3DES) for old Windows and macOS
# MYSETTINGS_PKI__P12_ENCRYPTION=aes256
# MYSETTINGS_PKI__CRL_DAYS=7

# ------------------------------------------------------------------ logging
MYSETTINGS_LOGGING__LEVEL=INFO
# Containers log to stdout only: Docker keeps and rotates it (json-file, 50m x 5 per service, docker-compose.yml;
# docker compose logs). A log file inside a container would land in its writable layer, outside that rotation, and
# its folder is not writable for MEDIA_UID. File logging is for a venv run without Docker (DEPLOYMENT.md).
MYSETTINGS_LOGGING__ENABLE_FILE_LOGGING=false
# MYSETTINGS_LOGGING__FILE_PATH=/var/log/radio_monitoring/app.log

# ------------------------------------------------------------------ health
# Lock health endpoint to internal hosts in production
MYSETTINGS_HEALTH__ENABLE_HOST_CHECK=true
MYSETTINGS_HEALTH__ALLOWED_HOSTS=["127.0.0.1", "localhost", "::1"]
