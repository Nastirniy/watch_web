# Environment Configuration Example
# Copy this file to .env and update with your secure values

# Application
MYSETTINGS_APP__ENVIRONMENT=production
MYSETTINGS_APP__DEBUG=false

# Database - Use environment variables for sensitive data
MYSETTINGS_DATABASE__HOST=localhost
MYSETTINGS_DATABASE__PORT=3306
MYSETTINGS_DATABASE__NAME=radio_monitoring
MYSETTINGS_DATABASE__USER=your_db_user
MYSETTINGS_DATABASE__PASSWORD=your_secure_db_password

# Security - CRITICAL: Generate secure values for production
MYSETTINGS_SECURITY__SECRET_KEY=your-256-bit-secret-key-change-this-in-production
MYSETTINGS_SECURITY__REQUIRE_HTTPS=true
MYSETTINGS_SECURITY__ALLOWED_ORIGINS=["https://yourdomain.com"]

# Server
MYSETTINGS_SERVER__HOST=127.0.0.1
MYSETTINGS_SERVER__PORT=8000
MYSETTINGS_SERVER__SSL_KEYFILE=/path/to/ssl/key.pem
MYSETTINGS_SERVER__SSL_CERTFILE=/path/to/ssl/cert.pem

# Logging
MYSETTINGS_LOGGING__ENABLE_FILE_LOGGING=true
MYSETTINGS_LOGGING__FILE_PATH=logs/radio_monitoring.log
MYSETTINGS_LOGGING__LEVEL=INFO

# Admin PKI (Generate proper certificates in production)
MYSETTINGS_ADMIN__PKI_CERTIFICATE_CN=your_admin_cn
MYSETTINGS_ADMIN__PKI_CERTIFICATE_SERIAL=your_admin_serial
MYSETTINGS_ADMIN__PKI_CERTIFICATE_FINGERPRINT=your_admin_fingerprint