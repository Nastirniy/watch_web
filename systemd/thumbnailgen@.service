# ============================================================================
# thumbnailgen@.service  (systemd instantiated/template unit)
# ============================================================================
# Generates a thumbnail for a single media file in its own process.
# Triggered by media-watcher.service when a new file is detected.
#
# The instance name (%I) is the unescaped file path, e.g.:
#   systemctl start thumbnailgen@$(systemd-escape -- "uploads/2025/01/30/obs_001/42_abc.mp4").service
#
# This runs the standalone thumbnail_worker.py which:
#   1. Looks up the MediaFile record in the database
#   2. Generates a thumbnail (PIL for images, PyAV for videos)
#   3. Updates the database with the thumbnail path
#
# Install:
#   sudo cp systemd/thumbnailgen@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# Check status of a specific instance:
#   systemctl status "thumbnailgen@$(systemd-escape -- 'uploads/file.mp4').service"
#
# View all recent thumbnail generation logs:
#   journalctl -u 'thumbnailgen@*' --since '1 hour ago'
# ============================================================================

[Unit]
Description=Thumbnail generation for %I
After=network.target mysql.service

[Service]
Type=oneshot

# -- Adjust these to match your deployment --
User=sh1zik
Group=sh1zik
WorkingDirectory=/home/sh1zik/mil-scan-api/

# %I = unescaped instance name = original file path
ExecStart=/home/sh1zik/mil-scan-api/venv/bin/python3 -m app.backend.services.thumbnail_worker "%I"

# Timeout: 5 minutes should be enough for even large video files
TimeoutStartSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=thumbnailgen

# Resource limits -- prevent runaway processes from starving the system
MemoryMax=512M
CPUQuota=50%%

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/sh1zik/mil-scan-api/
PrivateTmp=true
