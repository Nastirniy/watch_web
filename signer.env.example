# Environment of the pki-signer container (docker-compose.pki.yml): cp signer.env.example signer.env
# Only the signer reads this file; keep it 0600. Replace /srv/watch_web/pki with PKI_DIR from .env.
# (PKI.md, "The signer")

# edit: PKI_DIR
SIGNER_CA_CERT_PATH=/srv/watch_web/pki/ca/client-ca.crt
SIGNER_CA_KEY_PATH=/srv/watch_web/pki/private/client-ca.key
# Password of the CA key (empty for an unencrypted key)
SIGNER_CA_KEY_PASSWORD=
SIGNER_SOCKET_PATH=/srv/watch_web/pki/run/signer.sock
# Longest validity the signer signs for a certificate, and the longest CRL validity
SIGNER_MAX_VALIDITY_DAYS=730
SIGNER_MAX_CRL_DAYS=31
